# Get an API key at https://resend.com — required for contact forms
RESEND_API_KEY=re_xxxxxxxx

# Sender address. Use Resend's test sender until your domain is verified:
#   Astha Parajuli Website <onboarding@resend.dev>
# After verifying a domain in Resend, switch to e.g.:
#   Astha Parajuli Website <hello@yourdomain.com>
RESEND_FROM_EMAIL=Astha Parajuli Website <onboarding@resend.dev>

# Where inquiries are delivered (defaults to siteContact.email in siteData.js if unset).
# Important: while RESEND_FROM_EMAIL uses Resend's test domain (onboarding@resend.dev),
# Resend usually only allows delivery TO the exact email you used to create your Resend
# account. To send to another inbox, verify your own domain in Resend and set RESEND_FROM_EMAIL.
CONTACT_TO_EMAIL=wellbeing.astha@gmail.com
